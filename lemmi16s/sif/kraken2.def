Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author Zamir Granados
    Pipeline Kraken2
    Version 2.1.3

%post
    conda create -y -n kraken2env -c bioconda -c conda-forge \
        kraken2=2.1.3 \
        bracken=3.0.1 \
        python=3.10
    conda clean -a -y
    echo "source activate kraken2env" >> /environment

%environment
    export PATH=/opt/conda/envs/kraken2env/bin:$PATH

%runscript
    exec "$@"

%test
    . /opt/conda/etc/profile.d/conda.sh
    conda activate kraken2env
    kraken2 --version
    bracken --version
